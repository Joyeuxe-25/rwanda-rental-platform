# ---------------------------------------------------------------------------
# Rwanda Rental Platform — Frontend configuration (EXAMPLE)
# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. Only NEXT_PUBLIC_* values are
# exposed to the browser — there are NO secrets here. Authentication is handled
# by the backend via an HttpOnly cookie, never a token stored on the client.

# Backend API base URL (includes the /api/v1 version prefix).
# Local development (backend `wrangler dev` runs on :4000):
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production (set in your hosting env, e.g. Vercel) — replace with the real
# production API domain when finalized, e.g.:
# NEXT_PUBLIC_API_URL=https://api.YOUR_DOMAIN.com/api/v1
